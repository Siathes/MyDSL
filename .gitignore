url

# Connection credentials (auto-login password)
# The bare "login" entry below predates MyDSL_Login.lua (2026-08-26) --
# a full-repo grep found nothing that ever reads/writes a file by that
# literal name, so it looks like a planned-but-never-built earlier
# attempt at this same feature. Left as-is (harmless, doesn't collide
# with anything real) rather than removed, but it does NOT cover the
# real credential filename MyDSL_Login.lua actually uses -- that gets
# its own explicit entry below so this doesn't rely on the stale one.
login
MyDSL_login_credentials.lua

# AdjustableContainer position-state cache — auto-generated per window name,
# not source (confirmed 2026-07-05: contents are just x/y/width/height/hidden
# geometry dumps, not modules)
AdjustableContainer/

# Generic Mudlet package manager tool + its unrelated repo cache — not
# DSL-project-specific
mpkg/
mpkg.packages.json

# DSL_PeopleColors accumulated per-player color-assignment data (generated by
# the colors.xml module) — colors.xml itself is tracked as reference/config
DSL_PeopleColors_data*

# Binary / large asset files — not useful in version control
map.dat
map/
map downloads/
Sounds/
Portrait/
RoomPics/
media/

# Runtime logs and dynamic data
log/
MyDSL/logs/
MyDSL/portraits/
MyDSL/roompics/
MyDSL/data/

# LayoutEngine/WindowRegistry save-state — confirmed generated by our own
# code (table.save() output), not source; regenerated on every window
# move / tick. Layout reverted to per-profile 2026-07-08 (single shared
# MyDSL_layout.lua again, not character-bound — see docs/CHANGELOG.md);
# window visibility state stays character-bound (MyDSL_windowstate_<Char>.lua).
MyDSL_layout.lua
MyDSL_state.lua
MyDSL_windowstate_*.lua
# Same class, found accidentally git-tracked 2026-08-29 while extending
# build_mydsl_package.py's module discovery -- both are single-line
# table.save() dumps of Steven's own current theme/font choices (real
# content confirmed: `return {{[[active]]=[[refined_convergence]],},}` /
# a window-name-to-font-size map), not logic, same as the three above.
# Being git-tracked meant they'd get committed on every settings change
# AND could have been silently bundled as if they were real dofile
# Scripts -- excluded from that path too, see EXCLUDED_DATA_FILES in
# build_mydsl_package.py. git rm --cached'd the same day (kept on disk,
# matching the 3 files above -- not rewriting history, just stopping
# further tracking).
MyDSL_theme_settings.lua
MyDSL_windowfonts.lua

# Analysis & snapshot artifacts from Claude Code development sessions
MyDSL_audit_snapshot_*.txt
MyDSL_phase*.txt
MyDSL_Audit_Phase*/

# Archives
*.zip
*.tar.gz

# Sound assets loose at profile root (Sounds/ dir already covered above)
*.mp3

# Claude Code session data. settings.json is the one exception -- it's
# where the known-bad-pattern-check hook lives (added 2026-07-21, see
# scripts/check_known_patterns.sh), and that needs to survive across
# sessions/reinstalls, not just live on this one machine.
.claude/*
!.claude/settings.json

# Built package output — rebuilt on demand from the SCRIPT_FILES list in the
# packaging build script and delivered directly each time; committing the
# binary .mpackage/unpacked-XML build output itself just produces a full
# binary replace with no meaningful diff every rebuild (confirmed: 17 commits
# of pure "chore: rebuild" churn before this was untracked 2026-07-18).
MyDSL_Full.mpackage
MyDSL_Full/
# Same reasoning, same class of file -- rebuilt package output for the DSL
# Generic Mapper fork (source is DSL_Generic_Mapper.xml, which stays tracked).
DSL_Generic_Mapper.mpackage
# Same reasoning, same class of file -- rebuilt package output for the
# standalone DSL Mapper Addon (source is DSL_Mapper_Addon.xml, which
# stays tracked; built via build_dsl_mapper_addon_package.py, which also
# stays tracked).
DSL_Mapper_Addon.mpackage

# Python build tooling (build_mydsl_package.py) -- cache, not source
__pycache__/
*.pyc

# scripts/check_text_coverage.py's working files -- multi-MB extracted
# corpus text + pattern lists, regenerated on every run, not source
.text_coverage_scratch/

# Steven's personal annotated scratch copy of docs/OPTIMIZATION_AUDIT.md --
# already triaged into docs/TODO.md (see CHANGELOG.md 2026-08-27), kept as
# his own personal working file rather than merged wholesale, not project
# source
docs/myresponses.txt
