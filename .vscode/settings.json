{
  // Mudlet embeds Lua 5.1 (via LuaJIT) — target that dialect for accurate diagnostics.
  "Lua.runtime.version": "Lua 5.1",
  "Lua.runtime.builtin": {
    "io": "disable",
    "os": "disable"
  },
  "Lua.diagnostics.disable": ["lowercase-global"],
  "Lua.diagnostics.globals": [
    "MyDSL", "Geyser", "Adjustable", "demonnic",
    // MyCore -- an optional external package this profile doesn't ship
    // (not vendored, not in this repo); several MyDSL_*.lua files read
    // it as a soft fallback for character name/GMCP state (always
    // guarded, e.g. `if MyCore and MyCore.getChar then` -- see
    // MyDSL_DataLayer.lua's MyDSL.charName()), confirmed 2026-08-29 via
    // a full Lua-language-server diagnostic sweep. Real, intentional,
    // just undeclared -- not a typo.
    "MyCore",
    "cecho", "hecho", "decho", "echo", "cechoLink", "cechoPopup",
    "send", "sendAll", "expandAlias", "sendGMCP",
    "tempTimer", "tempTrigger", "tempAlias", "tempButtonToolbar",
    "permTimer", "permTrigger", "permAlias", "permGroup",
    "killTimer", "killTrigger", "killAlias",
    "enableTrigger", "disableTrigger", "enableTimer", "disableTimer",
    "enableAlias", "disableAlias", "enableKey", "disableKey",
    "registerAnonymousEventHandler", "raiseEvent", "deleteAllNamedTimers",
    "matches", "multimatches", "gmcp", "getMudletInfo",
    "display", "cecho2string", "createLabel", "setLabelStyleSheet",
    "openUserWindow", "createMiniConsole", "createBuffer",
    "selectString", "replace", "resetFormat", "moveCursor",
    "getLines", "getLineCount",
    "getMapEvents", "addMapEvent", "removeMapEvent", "removeMapMenu",
    "deleteRoom", "getAllRoomEntrances",
    "getRoomExits", "setExitStub", "updateMap",
    "downloadFile", "unzipAsync",
    "yajl", "utf8",
    // Added 2026-08-30 after a full lua-language-server --check sweep
    // (996 problems flagged headless vs. the real, settings.json-aware
    // count VSCode itself shows) confirmed these are real Mudlet Lua API
    // functions this project's own .lua files call, just never added to
    // this list -- not bugs.
    "hideWindow", "showWindow", "resizeWindow", "setBackgroundColor",
    "getAvailableFonts", "getTime", "rex", "saveWindowLayout",
    "saveProfile", "createMapper", "hasFocus", "showMenu", "setFont",
    "setBorderTop", "setBorderRight", "setBorderLeft", "setBorderBottom",
    "getRGB", "copy2decho", "copy2html", "decho2string", "hecho2string",
    "getColumnNumber", "tempPromptTrigger", "showNotification",
    "stopStopWatch"
  ],
  "Lua.workspace.checkThirdParty": false,
  "Lua.workspace.maxPreload": 3000,
  // Added 2026-08-30, same sweep as above: "PNP files/" (vendored PNP
  // reference source, never edited -- see CLAUDE.md) and "EMCOChat/"
  // (confirmed-dead vendored EMCO copy, see CLAUDE.md's MyDSL 1.0
  // mandate note) accounted for 605 of 996 flagged problems combined.
  // Neither is this project's own code, so there's nothing to fix there --
  // exclude both from diagnostics entirely rather than leaving that noise
  // in every file's Problems count.
  "Lua.workspace.ignoreDir": ["PNP files/", "EMCOChat/"],
  // Raised 2026-08-29 (was 1000 KB) -- MyDSL/creaturelore_db.lua (1.1MB)
  // and MyDSL/itemlore_db.lua (2.1MB, largest of these table.save()
  // data dumps) were both being skipped by the language server and
  // surfacing a "file too large" notification. These are pure data
  // (table.save() output, not source), so there's nothing to diagnose in
  // them anyway -- this just stops the notification, generous headroom
  // for continued data growth.
  "Lua.workspace.preloadFileSize": 10000,

  // This directory is a live Mudlet profile: source lives at the top level and in
  // MyDSL/, everything below is runtime/session data that should never be indexed,
  // watched, or searched — it's huge and irrelevant to editing code.
  "files.exclude": {
    "**/.git": true,
    "map/": true,
    "log/": true,
    "current/": true,
    "MyDSL/roompics/": true,
    "MyDSL/portraits/": true,
    "MyDSL/logs/": true,
    "map downloads/": true,
    "__pycache__/": true,
    "*.mp3": true
  },
  "search.exclude": {
    "map/": true,
    "log/": true,
    "current/": true,
    "MyDSL/roompics/": true,
    "MyDSL/portraits/": true,
    "MyDSL/logs/": true,
    "map downloads/": true,
    "Sounds/": true,
    "media/": true,
    "DSL_Helpfiles/": true,
    "__pycache__/": true,
    "*.mpackage": true,
    "*.xml": true
  },
  "files.watcherExclude": {
    "map/**": true,
    "log/**": true,
    "current/**": true,
    "MyDSL/roompics/**": true,
    "MyDSL/portraits/**": true,
    "MyDSL/logs/**": true,
    "map downloads/**": true,
    "Sounds/**": true,
    "media/**": true,
    "DSL_Helpfiles/**": true,
    "__pycache__/**": true
  },

  "editor.formatOnSave": false
}
